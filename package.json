{
  "name": "@petercjl/taobao-ai-ops",
  "version": "0.1.2",
  "description": "Independent Taobao AI operations SOP skills with a managed suite lifecycle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/taobao-ai-ops.git"
  },
  "type": "module",
  "bin": {
    "taobao-ai-ops": "bin/taobao-ai-ops.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "files": [
    "bin",
    "src",
    "skills/taobao-ai-operations",
    "contracts",
    "suite-manifest.json",
    "requirements.txt",
    "README.md",
    "!skills/**/tests/**",
    "!skills/**/__pycache__/**",
    "!skills/**/*.pyc",
    "!skills/**/*.bak",
    "!skills/**/.install-meta.json"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:business": "node scripts/test-business.mjs",
    "check": "node scripts/validate-suite.mjs",
    "prepack": "npm run check"
  }
}
