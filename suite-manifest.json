      "operations",
      "category-research",
      "product-research",
      "tbcli-tools",
      "sycmcli-tools",
      "html-report"
    ]
  },
  "nodes": [
    {
      "id": "html-report",
      "skill": "compact-commerce-ui",
      "component": "html-report",
      "stage": "shared-reporting",
      "method_version": "commerce-ui-template-pack@1",
      "requires_skills": [],
      "python_imports": ["jsonschema"],
      "scripts": [],
      "native_requirements": ["browser.report.inspect"]
    },
    {
      "id": "operations",
      "skill": "taobao-ai-operations",
      "stage": "routing",
      "method_version": "1.0",
      "requires_skills": [
        "yuce-category-opportunity-report",
        "taobao-search-product-form",
        "compact-commerce-ui"
      ],
      "python_imports": [],
      "scripts": [],
      "native_requirements": []
    },
    {
      "id": "category-research",
      "skill": "yuce-category-opportunity-report",
      "stage": "discover-market",
      "method_version": "yuce-category-opportunity@2.0",
      "requires_skills": [],
      "python_imports": [
        "openpyxl"
      ],
      "scripts": [
        "build_report.py"
      ],
      "native_requirements": [],
      "optional_tools": [
        "tbcli",
        "yccli"
      ],
      "component": "category-research"
    },
    {
      "id": "product-research",
      "skill": "taobao-search-product-form",
      "stage": "research-product",
      "method_version": "taobao-search-product-form@0.1.1",
      "requires_skills": [],
      "python_imports": [
        "pandas",
        "numpy",
        "openpyxl",
        "PIL",
        "jieba"
      ],
      "native_requirements": [
        "image.observe"
      ],
      "scripts": [
        "clean_search_export.mjs",
        "prepare.py",
        "analyze.py",
        "analyze_advertisers.py",
        "analyze_geography.py",
        "analyze_price_bands.py",
        "analyze_title_roots.py",
        "assemble_opportunity_evidence.py",
        "build_report_viewmodel.py",
        "build_visual_review_viewmodel.py",
        "cluster_visual_forms.py",
        "compile_style_prototypes.py",
        "compile_visual_review.py",
        "compile_visual_selection.py",
        "render_report.py",
        "validate_opportunity_cards.py",
        "validate_report_viewmodel.py",
        "visual_form_pipeline.py",
        "visual_observation_batches.py",
        "workflow_ledger.py"
      ],
      "component": "product-research"
    },
    {
      "id": "tbcli-tools",
      "skill": "tbcli",
      "component": "tbcli",
      "stage": "tools",
      "requires_skills": [],
      "python_imports": [],
      "scripts": [],
      "native_requirements": []
    },
    {
      "id": "sycmcli-tools",
      "skill": "sycmcli",
      "component": "sycmcli",
      "stage": "tools",
      "requires_skills": [],
      "python_imports": [],
      "scripts": [],
      "native_requirements": []
    }
  ],
  "tools": {
    "commerce-ui": {
      "package": "@petercjl/commerce-ui",
      "component": "html-report",
      "role": "versioned HTML templates, rendering and validation"
    },
    "tbcli": {
      "package": "@petercjl/tbcli",
      "entry": "scripts/tbcli.mjs",
      "role": "existing monthly exports, warehouse and additive category import",
      "component": "tbcli"
    },
    "sycmcli": {
      "package": "@petercjl/sycmcli",
      "entry": "scripts/sycmcli.mjs",
      "role": "store-bound market, category, keyword and competitor read operations",
      "component": "sycmcli"
    },
    "yccli": {
      "external": true,
      "minimum_version": "0.5.0",
      "executable_env": "TAOBAO_AI_OPS_YCCLI",
      "role": "authorized Yuce monthly collection; optional for supplied Excel"
    }
  },
  "targets": {
    "codex:macos": "implemented",
    "sealseek:macos": "implemented",
    "sealseek:windows": "implemented"
  },
  "update_policy": {
    "owner": "shell",
    "channel": "latest",
    "during_run": "installed-component-set",
    "automatic_install": false,
    "offline": "keep-current",
    "source_checkout": "git-managed"
  },
  "components": {
    "html-report": {
      "package": "@petercjl/commerce-ui",
      "bin": "commerce-ui",
      "skills": ["compact-commerce-ui"]
    },
    "category-research": {
      "package": "@petercjl/yuce-category-opportunity-report",
      "bin": "yuce-category-research",
      "skills": [
        "yuce-category-opportunity-report"
      ]
    },
    "product-research": {
      "package": "@petercjl/taobao-search-product-form",
      "bin": "taobao-search-form",
      "skills": [
        "taobao-search-product-form"
      ]
    },
    "tbcli": {
      "package": "@petercjl/tbcli",
      "bin": "tbcli",
      "skills": [
        "tbcli"
      ]
    },
    "sycmcli": {
      "package": "@petercjl/sycmcli",
      "bin": "sycmcli",
      "skills": [
        "sycmcli"
      ]
    }
  }
}
