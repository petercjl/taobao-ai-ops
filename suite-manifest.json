  "tools": {
    "procli": {
      "package": "@petercjl/procli",
      "component": "procli",
      "role": "project SOP, task dependencies, research publication and cumulative Agent Wiki"
    },
    "commerce-ui": {
      "package": "@petercjl/commerce-ui",
      "component": "html-report",
      "role": "versioned HTML templates, rendering and validation"
    },
    "tbcli": {
      "package": "@petercjl/tbcli",
      "entry": "scripts/tbcli.mjs",
      "role": "existing monthly exports, warehouse and additive category import",
      "component": "tbcli"
    },
    "sycmcli": {
      "package": "@petercjl/sycmcli",
      "entry": "scripts/sycmcli.mjs",
      "role": "store-bound market, category, keyword and competitor read operations",
      "component": "sycmcli"
    },
    "yccli": {
      "external": true,
      "minimum_version": "0.5.0",
      "executable_env": "TAOBAO_AI_OPS_YCCLI",
      "role": "authorized Yuce monthly collection; optional for supplied Excel"
    },
    "seedaudiocli": {
      "package": "@petercjl/seedaudiocli",
      "component": "seedaudiocli",
      "role": "audio generation, reference voices, image-conditioned audio and task recovery"
    },
    "1688cli": {
      "package": "@petercjl/1688cli",
      "component": "1688cli",
      "role": "sourcing-capability"
    },
    "1688-product-sourcing": {
      "package": "@petercjl/1688-product-sourcing",
      "component": "1688-product-sourcing",
      "role": "product-sourcing"
    },
    "1688-opportunity-sourcing-research": {
      "package": "@petercjl/1688-opportunity-sourcing-research",
      "component": "1688-opportunity-sourcing-research",
      "role": "opportunity-portfolio"
    }
  },
